{
  "name": "gm-mcp",
  "version": "0.3.0",
  "kind": "backend",
  "backend_package": "gm-mcp",
  "python_requires": ["httpx>=0.27,<1", "fastapi>=0.115,<1"],
  "deployment_modes": ["embedded", "gateway"],
  "default_deployment_mode": "embedded",
  "resource_requirements": [
    {
      "name": "mcp-gateway",
      "kind": "gateway",
      "resource_name": "mcp-gateway",
      "deployment_modes": ["gateway"],
      "base_directory": "/backend",
      "dockerfile": "/Dockerfile.mcp",
      "port": 8200,
      "public": true,
      "health_path": "/health"
    }
  ],
  "bindings": [
    {
      "key": "MCP_OAUTH_SECRET",
      "source": "generated_secret",
      "target": "mcp-gateway"
    }
  ]
}
